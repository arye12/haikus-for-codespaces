```html
<!DOCTYPE html>
<html lang="he">
<head>
  <meta charset="UTF-8">
  <title>תפוס את הריבוע!</title>
  <style>
    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      direction: rtl;
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #74ebd5, #ACB6E5);
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }

    #game-container {
      position: relative;
      width: 100%;
      height: 100%;
    }

    h1, #score {
      text-align: center;
      color: white;
      margin: 10px 0;
    }

    #box {
      width: 60px;
      height: 60px;
      background-color: #ff4757;
      position: absolute;
      display: none;
      border-radius: 10px;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
      cursor: pointer;
      z-index: 10;
      transition: left 0.3s, top 0.3s;
    }
  </style>
</head>
<body>
  <h1>תפוס את הריבוע!</h1>
  <div id="score">ניקוד: 0</div>
  <div id="game-container">
    <div id="box"></div>
  </div>

  <script>
    const box = document.getElementById('box');
    const scoreDisplay = document.getElementById('score');
    const margin = 20; // מרווח מהקצוות
    let score = 0;

    function randomPosition() {
      const container = document.getElementById('game-container');
      const maxX = container.clientWidth - box.offsetWidth - margin;
      const maxY = container.clientHeight - box.offsetHeight - margin;
      const x = Math.floor(Math.random() * (maxX - margin)) + margin;
      const y = Math.floor(Math.random() * (maxY - margin)) + margin;
      box.style.left = x + 'px';
      box.style.top = y + 'px';
    }

    function showBox() {
      randomPosition();
      box.style.display = 'block';

      setTimeout(() => {
        box.style.display = 'none';
        setTimeout(showBox, 2000); // איטי יותר
      }, 2000); // הריבוע נשאר יותר זמן
    }

    box.addEventListener('click', () => {
      score++;
      scoreDisplay.textContent = 'ניקוד: ' + score;
      box.style.display = 'none';
      setTimeout(showBox, 1500);
    });

    showBox();
  </script>
</body>
</html>
